# Copy to .env and fill in.  .env is git-ignored and excluded from the Docker image.
GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379/0

# Optional: Langfuse tracing (enabled only when BOTH keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region-specific URL from the Langfuse site (eu: https://cloud.langfuse.com, us: https://us.cloud.langfuse.com)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_IO=false        # send metadata/usage only, not prompts/completions

# Optional: per-run limits and cost estimate
# TOKEN_BUDGET_PER_RUN=60000
# LLM_PRICE_PER_1M_TOKENS={"<model-id>":[<usd_per_1M_input>,<usd_per_1M_output>]}   # leave unset on free tiers
# Gemini is the only provider (no fallback).  Fast model for most agents, strong model only for GEMINI_STRONG_AGENTS.
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_STRONG_MODEL=gemini-3.8-flash
# GEMINI_STRONG_AGENTS=writer             # comma-separated; the strong model has only 20 requests/day on the free tier
# JUDGE_MODEL=                            # grounding + evaluation judge; empty = the fast model
# GEMINI_RATE_LIMITS={"gemini-3.8-flash":{"rpm":5,"tpm":250000,"rpd":20},"gemini-3.5-flash-lite":{"rpm":15,"tpm":250000,"rpd":500}}
# GEMINI_THINKING_LEVEL=                  # "", minimal, low, medium, high (thinking_budget=0 is rejected by Gemini 3 models)

# Search quality (defaults shown)
# QUERY_REWRITE=llm            # llm | rules | off
# ARXIV_ENABLED=true
# DEBATE_MAX_ROUNDS=0          # review loop is opt-in (UI checkbox); 2 = one revision

# SEARCH_MODE=fixed              # "react" = model-driven search loop (see docs/ARCHITECTURE.md); REACT_MAX_STEPS=4
# LANGFUSE_PROMPTS=true          # take SYSTEM prompts from Langfuse Prompt Management (needs LANGFUSE_* keys); falls back to the repo text
# LANGFUSE_PROMPT_LABEL=production   # e.g. staging to test a prompt edit; push prompts: uv run python scripts/sync_prompts.py
# GROUNDING_JUDGE=true           # LLM check of every cited claim (uses JUDGE_MODEL); false to save tokens
# LLM_OVERLOAD_BACKOFF_SECONDS=8     # wait per attempt after a 503/504 'high demand' error (8 s, 16 s, 24 s ...)
